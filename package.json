{
  "name": "n8n-nodes-reepl",
  "version": "1.0.6",
  "description": "Reepl nodes for n8n: LinkedIn content actions and webhook triggers",
  "license": "MIT",
  "homepage": "https://help.reepl.io/integrations/n8n",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/reepl-io/reepl-n8n-app.git"
  },
  "author": {
    "name": "Reepl",
    "email": "support@reepl.io"
  },
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "reepl",
    "linkedin",
    "automation"
  ],
  "files": [
    "dist"
  ],
  "main": "dist/nodes/Reepl/Reepl.node.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-static-files.mjs",
    "build:watch": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepublishOnly": "npm run build && npm test"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.6.3",
    "n8n-workflow": "^1.100.1"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/ReeplApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Reepl/Reepl.node.js",
      "dist/nodes/Reepl/ReeplTrigger.node.js"
    ]
  }
}
